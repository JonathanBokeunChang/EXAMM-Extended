connect_db.sh
build/*
.DS_Store
copy_binary_windows.sh
copy_binary_linux.sh
copy_binary_osx.sh
run.sh
*/__pycache__/*
__pycache__/*
*.pyc
visualization/plots/*
test_output/*
.gstack/
build_asan/*

# Generated volatility datasets (~216 MB of CSVs). Rebuild exactly with
# scripts/stock_run/build_vol_dataset.py; the provenance files below stay tracked so the
# universe and split boundaries are reproducible from git alone.
datasets/qlib_vol*/*.csv
datasets/qlib_vol*/*/*.csv
!datasets/qlib_vol*/MANIFEST.csv
!datasets/qlib_vol*/TICKERS.txt

# Per-row model predictions (~185 MB). The scored summaries, validation reports and
# manifests ARE tracked -- those are the paper's numbers; the raw rows are regenerable.
results/baselines/*/predictions/

# Pinned qlib source bundles (~1 GB extracted). Re-acquire byte-identically with
# scripts/stock_run/acquire_bundle.py; BUNDLE.json carries the pinned release tag and SHA256
# and stays tracked, so the exact source is reproducible from git alone.
datasets/_bundles/*
!datasets/_bundles/*/
!datasets/_bundles/*/BUNDLE.json

# Generated MASTER-replica datasets (~2 GB of CSVs per bundle). Rebuild exactly with
# scripts/stock_run/build_csi300_master_replica.py --bundle <name>; MANIFEST.json pins the
# source bundle, parameters and a content hash, and eval_index.csv is the frozen row set every
# model must score -- both stay tracked so the benchmark is reproducible from git alone.
datasets/csi300_master_replica*/*.csv
!datasets/csi300_master_replica*/eval_index.csv

# Seed genomes for the seeded-EXAMM experiment: regenerable build artifacts, not source.
# anvil_pretrain_seed.sb emits and pretrains them on the cluster from the tracked scripts, so
# committing ~3 MB of binaries would add nothing reproducible.
seeds/

# Third-party harness clone + its venv, both built by scripts/transformer_bench/setup_anvil.sh
# from a pinned upstream URL. Regenerable, and the venv alone is ~2 GB of CUDA wheels.
external/

# Per-session scratch directory.
scratchpad/

# Transformer run artifacts: checkpoints, raw pred/true arrays and training logs are large and
# regenerable from the sbatch scripts. The small tidy outputs (predictions.csv, *_index.csv,
# scaler.json, comparison_*.csv) stay tracked so results can be re-scored without a GPU.
results/transformer_bench/**/checkpoints/
results/transformer_bench/**/*.npy
results/transformer_bench/**/train.log
