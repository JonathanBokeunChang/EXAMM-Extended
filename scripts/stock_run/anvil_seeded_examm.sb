#!/bin/bash -l
# STAGE 2: neuroevolutionary refinement of a PRETRAINED GRU (seeded EXAMM).
#
# THE QUESTION
# ------------
# From scratch, EXAMM sits ON the GRU capacity curve, never above it. Four configs, all within 15bp
# of the fitted line IC = 0.0092*log10(params) + 0.0131 (r=0.947):
#     d45 3-seed ens  76w  +0.0289 | bpi30  74w +0.0297 | grow3 192w +0.0329
# and growth-by-mutation cannot climb out: ~1 net hidden node per ~900 genomes, so GRU-2x32-level
# capacity would need O(10^5) genomes. Seeding removes that compute wall and changes the question
# from "can evolution CLIMB to scale?" to "GIVEN scale, can evolution IMPROVE a hand-designed net?"
#
# WHAT EVOLUTION ACTUALLY DOES HERE (measured on the canary, not assumed)
# -----------------------------------------------------------------------
# add_node IS THE DOMINANT SUPPLIER OF MULTI-SCALE RECURRENCE -- not add_recurrent_edge.
# A new node's fan-in/fan-out is drawn as fmax(1, 2 + N(avg_inputs, sigma)) from the GENOME-WIDE
# average (rnn_genome.cxx:2868-2869), and its connections are split plain/recurrent by
# recurrent_probability = enabled_rec / (enabled_rec + enabled_edges) (rnn_genome.cxx:2875-2876).
# On this seed that average is (1248+1248)/71 = 35.2 and the probability is exactly 0.500, so ONE
# add_node event creates ~37 plain + ~34 recurrent edges + 1 bias = ~72 weights.
# The canary confirms it exactly: 3151 - 3079 = 72 weights, +1 node, +37 edges, +34 rec. That was a
# SINGLE mutation event, not 169 genomes of accumulation.
# add_node and add_recurrent_edge are drawn with equal probability (1/8 of reachable ops,
# examm.cxx:1219-1240), but add_node delivers ~34 recurrent edges per event against
# add_recurrent_edge's 1. Attribute the recurrence claim accordingly.
# Expect ~11 accepted add_nodes over 1800 genomes -> ~+780 connections, mildly compounding (each
# event raises avg_inputs, so the next node is wider).
# Node TYPES still enter only via add_node / split_node / merge_node / split_edge (examm.cxx:152)
# and existing nodes are never retyped, so the genome stays overwhelmingly GRU. Do NOT claim
# "evolution mixes cell types" for this arm -- that is a from-scratch property (grow3 reached
# 4 LSTM / 3 GRU / 2 UGRNN / 1 Elman from a MINIMAL seed). GROW_SHRINK is the only mechanism that
# retypes nodes on a seeded genome, via merge_node (see below).
#
# THE CONTROL IS THE PAPER
# ------------------------
# Arm B (this script) gets pretraining PLUS N genomes of extra backprop. The seed got pretraining
# only. So "we just trained it longer" is the obvious objection, and a bare "seed vs seeded-EXAMM"
# comparison cannot answer it. The control is the SAME seed given the SAME CPU-hours of continued
# finetune_rnn training, no evolution. Headline = B - A, paired, HAC, on the frozen eval index.
# Also commit to the fixed-depth ablation: if evolution just picks one depth everywhere, a sweep
# over --max_recurrent_depth would have found it cheaper and that is the honest conclusion.
#
# submit from the repo root on Anvil:
#   mkdir -p slurm_logs
#   # arm B1 -- standard EXAMM (no grow-shrink)
#   sbatch --export=ALL,SEED_GENOME=seeds/gru_2x32_pretrained.bin,RUN_TAG=seed32_plain \
#          --array=0-2 scripts/stock_run/anvil_seeded_examm.sb
#   # arm B2 -- grow-shrink phases (adds merge_node type turnover + pruning pressure)
#   sbatch --export=ALL,SEED_GENOME=seeds/gru_2x32_pretrained.bin,RUN_TAG=seed32_gs,GROW_SHRINK=1 \
#          --array=0-2 scripts/stock_run/anvil_seeded_examm.sb
#
# Output: $OUT_ROOT/run_R/global_best_genome_*.bin   (+ .done, safe to resubmit)

#SBATCH --account=cis251123
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1
# 24h, not 12. The 227 genomes/hr canary rate was measured under 2-WAY node sharing. On the shared
# partition the 6 array tasks (3x B1 + 3x B2) can pack four 32-rank jobs onto one 128-core node; at
# ~150/hr, 1800 genomes is 12h + startup and gets walltime-killed. That matters more than losing the
# tail: if B1 and B2 truncate at DIFFERENT genome counts the arms are confounded, not just short.
# SLURM bills actual usage, so the only cost of the larger request is queue priority.
#SBATCH --time=24:00:00
#SBATCH --job-name=seeded_examm
#SBATCH --array=0-2
#SBATCH --output=slurm_logs/seeded_%A_%a.out
#SBATCH --error=slurm_logs/seeded_%A_%a.err

module --force purge
module load gcc/11.2.0 openmpi/4.1.6

cd "$SLURM_SUBMIT_DIR"
set -u

DATA_DIR=${DATA_DIR:-datasets/csi300_master_replica_invdata_seq}
SEED_GENOME=${SEED_GENOME:?set SEED_GENOME=<pretrained .bin from anvil_pretrain_seed.sb>}
INPUTS=${INPUTS:-"RET OPEN_C HIGH_C LOW_C VWAP_C VOLR"}
OUTPUT=${OUTPUT:-LABEL_CSRANK}

# MAXG: budget must SHRINK with seed size or the job is a non-experiment; re-measure whenever the
# seed size or bp_iterations changes.
# MEASURED, not extrapolated. Canary (1h, 32 ranks, gru_2x32 seed, bp_iterations=10, contending with
# a second canary on the same node): 169 genomes in 53 min, steady-state ~227 genomes/hr once the
# ~20-min startup (32 ranks x 612 CSVs) amortizes. Over 12h that is ~2,650; at a 30% margin -> 1800.
# The margin covers NaN-fitness genomes, which consume a worker WITHOUT counting against max_genomes
# (examm.cxx:358), and per-genome cost rising as genomes grow.
# Finishing matters beyond losing the tail: if B1 and B2 hit the wall at DIFFERENT genome counts the
# arms are confounded, not merely truncated.
# Re-measure if the seed size, bp_iterations, or the universe changes -- this number is specific to
# 3,079 weights at bp_iterations=10.
MAXG=${MAXG:-1800}
ISLANDS=${ISLANDS:-10}
ISLAND_SIZE=${ISLAND_SIZE:-10}

# bp_iterations 10, NOT 30. The seed is already converged, so extra per-genome epochs are mostly
# wasted and partly harmful: 30 epochs x 306 series is ~9,180 fresh Adam steps at lr 1e-3 from a
# converged point, checkpointed by a max over 30 validation evaluations -- i.e. 30 draws of
# validation noise per genome on a project where validation does not predict test IC (r=+0.065).
# Dropping 30->10 also cuts cost/genome ~2.9x, buying ~2.9x more genomes. Structural turnover, not
# per-genome convergence, is the bottleneck here (~2 new nodes per 1,700 genomes).
BP_ITERATIONS=${BP_ITERATIONS:-10}

# num_mutations 1, matching every prior arm. Raising it to 3 does NOT fix node-count inertia: with
# EXAMM's default symmetric rates (examm.cxx:1215-1240, all 1.0 except split_edge=0) the drift is
# add_node + split_node - merge_node - disable_node ~= 0, i.e. a zero-drift random walk. More
# mutations per genome triples the VARIANCE, not the drift. What it does buy is ~1.5 destructive
# edits per genome (disable_edge/disable_node/split_node/merge_node are 4 of 8 reachable ops),
# geometrically lower acceptance, and -- fatally for the paper -- no way to attribute an accepted
# improvement to add_recurrent_edge, which is the whole claim. Bias the OPERATOR instead:
#   --clone_rate 0 --add_recurrent_edge_rate 3   (raises its share from 1/8 to ~1/3)
# NOTE those overrides are silently DEAD in the grow-shrink arm: examm.cxx:460-493 hard-assigns all
# eleven rates every mutate() call whenever both phase lengths are > 0. Use them in B1 only, or in
# neither, or B1-vs-B2 stops being a clean contrast.
NUM_MUTATIONS=${NUM_MUTATIONS:-1}

# The seed is depth 1 (a standard GRU). Evolution runs at depth 45 so add_recurrent_edge can reach
# scales the seed cannot -- that asymmetry IS the hypothesis. Depth 60 crashes EXAMM with
# "inputs_fired ... total_inputs" (edge bookkeeping bug); 45 is verified clean.
MAX_REC_DEPTH=${MAX_REC_DEPTH:-45}

# Extinction kept at 500, MATCHING the from-scratch arms (d45/bpi30/grow3), deliberately.
# It fires exactly TWICE at MAXG=1800: the guard at island_speciation_strategy.cxx:224-225 requires
# max_genomes - evaluated >= 500, so events land at evaluated=500 and 1000, and 1500 is suppressed
# (1800-1500 = 300 < 500).
# The real cost is NOT the ~20 repopulated genomes. While any island is REPOPULATING, islands_full()
# returns false (island_speciation_strategy.cxx:149-157), and line 416 then forces MUTATION-ONLY for
# every island in the run. Refilling an erased island takes ~100 generated genomes at 1-in-10
# round-robin, so each event disables crossover globally for ~100 genomes -- roughly 200 of 1800
# (11%) of the budget runs mutation-only.
# Kept anyway: it matches the from-scratch arms' per-500-genome cadence, and mutation-only windows
# are arguably MORE on-hypothesis, not less. Set EXTINCTION=0 for the no-extinction variant.
EXTINCTION=${EXTINCTION:-500}
NORMALIZE=${NORMALIZE:-avg_std_dev}
SAVE_GENOMES=${SAVE_GENOMES:-all_best_genomes}

# v1 ONLY. v1's branches are guarded by `if (!new_inputs[i]) continue;` (rnn_genome.cxx:4398,4411),
# so with the seed's parameter names matching the dataset exactly it is a verified no-op. v2 and v3
# are NOT guarded (rnn_genome.cxx:4431,4437,4446,4452) -- they iterate EVERY input/output including
# pre-existing ones and rewire them with fresh Lamarckian weights, silently altering the
# architecture before evolution starts. The flag is mandatory when --genome_bin is given
# (generate_nn.cxx:221, required=true), so it cannot simply be omitted.
TL_VERSION=${TL_VERSION:-v1}

# GROW_SHRINK=1 alternates pure-growth and pure-shrink operator windows (examm.cxx:460). It is the
# ONLY mechanism that changes cell types on a seeded genome: shrink phases set merge_node_rate=1,
# and merge_node collapses two nodes into one NEW node of a RANDOM type. Growth alone cannot retype
# anything. G:50 / S:200 is the published configuration.
GROW_SHRINK=${GROW_SHRINK:-0}
GROWTH_PHASE=${GROWTH_PHASE:-50}
REDUCTION_PHASE=${REDUCTION_PHASE:-200}
GS_ARGS=()
if [ "$GROW_SHRINK" != "0" ]; then
  GS_ARGS=( --growth_phase_genomes "$GROWTH_PHASE" --reduction_phase_genomes "$REDUCTION_PHASE" )
fi

# --epigenetic_weights preserves the PRETRAINED weights through transfer_to (rnn_genome.cxx:4503).
EPIGENETIC=${EPIGENETIC:-1}
EPI_ARGS=()
[ "$EPIGENETIC" != "0" ] && EPI_ARGS=( --epigenetic_weights )

# ---- --start_filled IS MANDATORY, NOT OPTIONAL --------------------------------------------------
# --epigenetic_weights alone does NOT preserve the pretrained weights. It only gates transfer_to's
# reset, which runs UPSTREAM of island population. Without --start_filled, islands are constructed
# empty (island.cxx:28) so generate_for_initializing_island runs, and at
# island_speciation_strategy.cxx:297-298 it does:
#       new_genome = seed_genome->copy();
#       new_genome->initialize_randomly();     // <-- UNCONDITIONAL
# i.e. every island's founding genome keeps the seed's ARCHITECTURE and throws away its WEIGHTS,
# and every later genome descends from that random-weight ancestor. The run silently becomes
# from-scratch EXAMM at a fixed 2xN GRU topology -- guaranteed to lose to the compute-matched
# control and to mean nothing. A smoke test CANNOT catch this by checking node/edge/weight COUNTS;
# the structure survives, only the values die.
# With --start_filled, Island::fill_with_mutated_genomes pushes weight-carrying copies and flips the
# island to FILLED (island.cxx:443-471), so generate_for_initializing_island is never reached.
# This matches anvil_vol_warm.sb:102, the warm-start invocation already proven in this repo.
START_FILLED=${START_FILLED:-1}
FILL_ARGS=()
[ "$START_FILLED" != "0" ] && FILL_ARGS=( --start_filled )

# NEVER pass --seed_stirs: Island::fill_with_mutated_genomes copies the genome and then mutates the
# SHARED seed_genome rather than the copy (island.cxx:449-450), so the seed accumulates mutations
# across all fill calls and later islands drift arbitrarily far from the pretrained weights. It is
# harmless only at the default 0, where EXAMM::mutate breaks immediately.
# NEVER pass --tl_epigenetic_weights: its live consumer is INVERTED -- island.cxx:452-454 calls
# initialize_randomly() WHEN it is true, i.e. passing it randomizes the weights you are preserving.

# Extinction flags are only meaningful together; omit all three when disabled. (island_ranking_method
# is passed explicitly rather than relying on "" falling through to the EraseWorst branch at
# island_speciation_strategy.cxx:226.)
EXT_ARGS=()
if [ "$EXTINCTION" != "0" ]; then
  EXT_ARGS=( --extinction_event_generation_number "$EXTINCTION"
             --islands_to_exterminate 1 --repopulation_method bestGenome
             --island_ranking_method EraseWorst )
fi

# max_recurrent_depth must stay STRICTLY BELOW the shortest training series, or
# RNN_Recurrent_Edge::first_propagate_forward writes inputs_fired[i] past the end
# (rnn_recurrent_edge.cxx:150-155) and first_propagate_backward indexes negative -- heap corruption
# surfacing as the "inputs_fired ... total_inputs" fatal. That, not an edge-bookkeeping bug, is why
# depth 60 crashed: the shortest train series in this universe is 55 rows (SZ002252).
MIN_SERIES=${MIN_SERIES:-55}
if [ "$MAX_REC_DEPTH" -ge "$MIN_SERIES" ]; then
  echo "ERROR: MAX_REC_DEPTH=$MAX_REC_DEPTH >= shortest train series ($MIN_SERIES) -- out-of-bounds" >&2
  echo "       recurrent-edge propagation. Lower it, or re-measure MIN_SERIES if the universe changed." >&2
  exit 1
fi

RUN_TAG=${RUN_TAG:-seeded}
OUT_ROOT=${OUT_ROOT:-test_output/seeded_examm_${RUN_TAG}}
BIN=build/mpi/examm_mpi

RUN=$(( ${SLURM_ARRAY_TASK_ID:-0} + 1 ))
OUT=$OUT_ROOT/run_$RUN

echo "### seeded EXAMM | seed $SEED_GENOME | run $RUN | genomes $MAXG | bpi $BP_ITERATIONS"
echo "### mutations $NUM_MUTATIONS | evolve depth $MAX_REC_DEPTH | grow_shrink ${GS_ARGS[*]:-off} | epigenetic $EPIGENETIC"

[ -x "$BIN" ] || { echo "ERROR: $BIN not found" >&2; exit 1; }
[ -d "$DATA_DIR" ] || { echo "ERROR: $DATA_DIR missing" >&2; exit 1; }
[ -f "$SEED_GENOME" ] || { echo "ERROR: seed '$SEED_GENOME' missing -- run anvil_pretrain_seed.sb first" >&2; exit 1; }
if [ -f "$OUT/.done" ]; then echo "run $RUN already complete -- skipping"; exit 0; fi

if [ "$MAXG" -lt $(( 10 * ISLANDS * ISLAND_SIZE )) ]; then
  echo "WARNING: MAXG=$MAXG is under 10x the island population ($((ISLANDS*ISLAND_SIZE))) --" >&2
  echo "         that is barely more than filling the population, not a search." >&2
fi

UNIV="$DATA_DIR/_train_universe.txt"
[ -f "$UNIV" ] || { echo "ERROR: $UNIV missing" >&2; exit 1; }
TRAIN=(); VAL=()
while read -r s; do
  case "$s" in ''|\#*) continue;; esac
  TRAIN+=( "$DATA_DIR/${s}_train.csv" ); VAL+=( "$DATA_DIR/${s}_val.csv" )
done < "$UNIV"
[ "${#TRAIN[@]}" -eq "${#VAL[@]}" ] && [ "${#TRAIN[@]}" -gt 0 ] \
  || { echo "ERROR: train/val mismatch (${#TRAIN[@]}/${#VAL[@]})" >&2; exit 1; }
echo "### universe: ${#TRAIN[@]} matched train/val pairs"

mkdir -p "$OUT"
srun -n "${SLURM_NTASKS}" "$BIN" \
  --training_filenames "${TRAIN[@]}" \
  --validation_filenames "${VAL[@]}" \
  --time_offset 0 \
  --input_parameter_names $INPUTS \
  --output_parameter_names $OUTPUT \
  --genome_bin "$SEED_GENOME" \
  --transfer_learning_version "$TL_VERSION" \
  ${EPI_ARGS[@]+"${EPI_ARGS[@]}"} \
  --number_islands "$ISLANDS" --island_size "$ISLAND_SIZE" \
  --max_genomes "$MAXG" --bp_iterations "$BP_ITERATIONS" \
  --num_mutations "$NUM_MUTATIONS" --normalize "$NORMALIZE" \
  --max_recurrent_depth "$MAX_REC_DEPTH" \
  ${EXT_ARGS[@]+"${EXT_ARGS[@]}"} \
  --save_genome_option "$SAVE_GENOMES" \
  ${FILL_ARGS[@]+"${FILL_ARGS[@]}"} \
  ${GS_ARGS[@]+"${GS_ARGS[@]}"} \
  --seed "$RUN" --output_directory "$OUT" \
  --std_message_level ERROR --file_message_level NONE
rc=$?

gb=$(ls "$OUT"/global_best_genome_*.bin 2>/dev/null | wc -l | tr -d ' ')
echo "### run $RUN finished rc=$rc global_best=$gb"
if [ "$rc" = "0" ] && [ "$gb" != "0" ]; then
  touch "$OUT/.done"
else
  # SAVE_GENOMES=all_best_genomes means a walltime kill is still recoverable:
  #   python3 scripts/stock_run/salvage_best_genome.py --run-dir $OUT
  echo "ERROR: run $RUN produced no global best (walltime kill? try salvage_best_genome.py)" >&2
  exit 1
fi
