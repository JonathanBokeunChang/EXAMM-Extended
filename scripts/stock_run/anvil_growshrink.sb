#!/bin/bash -l
# NOTE the -l flag!
#
# GROW-SHRINK arm as a job array: 500 jobs, one per stock/run (50 x 10),
# grow-shrink phase config G:50/S:200 (the paper's best model-reducer:
# Singh/Lyu/Desell EvoStar 2026). Same EXAMM settings and data as the baseline
# (test_output/baseline / v2) -- the ONLY difference is the two phase args, so
# this arm is directly comparable to the existing baseline.
#
# Each job calls pilot_train.sh (env-parametrized) with GROW_PHASE/SHRINK_PHASE
# set. Writes to test_output/growshrink (distinct dir; does NOT touch baseline).
# Corrupted saves are filtered afterward by sweep_verify.py, same protocol.
#
# REQUIRES the grow-shrink binary: check out branch grow-shrink and rebuild
# examm_mpi first (the phase args do nothing on the old binary).
#
# submit from the repo root:
#   mkdir -p slurm_logs
#   sbatch --array=0 scripts/stock_run/anvil_growshrink.sb    (test 1 job first)
#   sbatch scripts/stock_run/anvil_growshrink.sb              (all 500)
#
# safe to resubmit, finished runs are skipped (.done)

#SBATCH --account=cis251123
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --cpus-per-task=1
#SBATCH --time=00:45:00
#SBATCH --job-name=examm_growshrink
#SBATCH --array=0-499
#SBATCH --output=slurm_logs/gs_%A_%a.out
#SBATCH --error=slurm_logs/gs_%A_%a.err

module --force purge
module load gcc/11.2.0 openmpi/4.1.6

cd "$SLURM_SUBMIT_DIR"

# job index picks the stock and run: index/10 = stock, index%10+1 = run
TICKERS=($(ls datasets/701515_split | sed -E 's/_(train|val|test)\.csv$//' | sort -u | grep -v combined_predictors))

if [ ${#TICKERS[@]} -ne 50 ]; then
    echo "ERROR: expected 50 tickers, found ${#TICKERS[@]}" >&2
    exit 1
fi

S=${TICKERS[$((SLURM_ARRAY_TASK_ID / 10))]}
R=$((SLURM_ARRAY_TASK_ID % 10 + 1))

echo "job $SLURM_ARRAY_TASK_ID -> $S run $R (grow-shrink G:50/S:200)"
GROW_PHASE=50 SHRINK_PHASE=200 \
    DATA="$SLURM_SUBMIT_DIR/datasets/701515_split" \
    BASE_OUT="$SLURM_SUBMIT_DIR/test_output/growshrink" \
    RUNS=10 MAX_GENOMES=10000 \
    ONLY_RUN=$R MPI_LAUNCH="srun --kill-on-bad-exit" \
    sh scripts/stock_run/pilot_train.sh "$S"
