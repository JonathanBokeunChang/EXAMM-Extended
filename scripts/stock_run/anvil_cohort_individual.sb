#!/bin/bash -l
# NOTE the -l flag!
#
# Individual (per-stock) EXAMM baseline training on a walk-forward cohort -- the
# construction compared against pooled in results/baseline_audit.md: 50 STOCKS x 10
# RUNS EACH, one independent model per stock (no pooling, no cross-stock sharing).
#
# This is the SAME recipe as scripts/stock_run/baseline_train.sh / anvil_baseline.sb
# (10 islands x 10, extinction every 200, bp 10, num_mutations 1) -- just pointed at
# a walk-forward cohort's ALIGNED data instead of the fixed 701515_split, so results
# land on the exact same train/val/test windows as the pooled EXAMM tables
# (cohort_2020_aligned -> trade 2022, cohort_2021_aligned -> trade 2023).
#
# GENOMES ARE SAVED: baseline_train.sh's --save_genome_option none still ALWAYS
# writes the final global_best_genome_<N>.bin per run at natural termination
# (examm.cxx, unconditional at max_genomes) -- "none" only skips saving EVERY
# intermediate new-best during the run, not the final one. So this produces exactly
# 10 genomes per stock (500 per cohort), which is what the ensemble comparison needs
# -- last time only the single val-selected genome per stock was ever downloaded.
#
# Each genome is verified against its own recorded validation MSE before being
# marked .done (verify_genome.sh, inside baseline_train.sh) -- guards against the
# depth-sort corruption bug; see [[genome-corruption-bug]] if that name means
# anything to you, otherwise: this campaign will self-report if a save is bad rather
# than silently shipping a corrupted genome.
#
# submit from the repo root, ONE PER COHORT:
#   mkdir -p slurm_logs
#   sbatch --export=ALL,COHORT=cohort_2020_aligned --array=0 scripts/stock_run/anvil_cohort_individual.sb   # canary (1 job)
#   sbatch --export=ALL,COHORT=cohort_2020_aligned scripts/stock_run/anvil_cohort_individual.sb              # full 500 (trade 2022)
#   sbatch --export=ALL,COHORT=cohort_2021_aligned scripts/stock_run/anvil_cohort_individual.sb              # full 500 (trade 2023)
#
# Output: test_output/<COHORT>_individual/<TICKER>/run_<R>/global_best_genome_*.bin (+.done)
# safe to resubmit -- finished (ticker, run) pairs are skipped.
#
# Cost estimate (same as anvil_baseline.sb, which this mirrors): ~700-1000 core
# hours total per cohort (8 cores x ~10-15 min per job x 500 jobs).

#SBATCH --account=cis251123
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=8
#SBATCH --cpus-per-task=1
#SBATCH --time=00:45:00
#SBATCH --job-name=cohort_indiv
#SBATCH --array=0-499
#SBATCH --output=slurm_logs/ci_%A_%a.out
#SBATCH --error=slurm_logs/ci_%A_%a.err

module --force purge
module load gcc/11.2.0 openmpi/4.1.6

cd "$SLURM_SUBMIT_DIR"
set -u

: "${COHORT:?set COHORT=cohort_2020_aligned or cohort_2021_aligned}"
DATA_DIR=datasets/walkforward/$COHORT
if [ ! -d "$DATA_DIR" ]; then
    echo "ERROR: $DATA_DIR missing" >&2; exit 1
fi

# job index picks the stock and run: index/10 = stock, index%10+1 = run
# (identical indexing scheme to anvil_baseline.sb, so the array size/meaning is familiar)
TICKERS=($(ls "$DATA_DIR" | sed -E 's/_(train|val|test)\.csv$//' | sort -u))
if [ "${#TICKERS[@]}" -ne 50 ]; then
    echo "ERROR: expected 50 tickers in $DATA_DIR, found ${#TICKERS[@]}" >&2
    exit 1
fi

S=${TICKERS[$((SLURM_ARRAY_TASK_ID / 10))]}
R=$((SLURM_ARRAY_TASK_ID % 10 + 1))

echo "job $SLURM_ARRAY_TASK_ID -> cohort=$COHORT stock=$S run=$R"
DATA="$DATA_DIR" \
BASE_OUT="test_output/${COHORT}_individual" \
ONLY_RUN=$R \
MPI_LAUNCH="srun --kill-on-bad-exit" \
  sh scripts/stock_run/baseline_train.sh "$S"
