#!/bin/bash -l
# NOTE the -l flag!
#
# Cross-sectional IC (Information Coefficient) training on the walk-forward
# returns cohort -- Dr. Lyu's objective. One POOLED tiny genome (6->1) is trained
# on ALL 50 stocks simultaneously, optimizing the daily cross-sectional rank
# correlation between predicted and realized next-day returns (rnn/ic_loss.*),
# with fitness = validation Spearman IC. Split: train <=2021, val 2022, trade 2023.
#
# The array is over SEEDS/runs (for ensembling -- average predictions across runs
# before ranking, per the volatility recipe). One cohort, so IDX == run index.
#
# submit from the repo root:
#   mkdir -p slurm_logs
#   sbatch --array=0 scripts/stock_run/anvil_ic.sb                       # IC canary (1 run)
#   sbatch --array=1-9 scripts/stock_run/anvil_ic.sb                     # IC ensemble (remaining 9)
#   sbatch --export=ALL,LOSS=mse --array=0-9 ...                         # MATCHED MSE baseline (same everything, only loss differs)
#   sbatch --export=ALL,LOSS=mse,TARGET=RET_CS,DATA_DIR=datasets/walkforward/cohort_2021_zscore --array=0-9 ...
#                                                                        # z-score-MSE arm (Qlib CSZScoreNorm; build cohort w/ build_cs_target.py)
#   sbatch --export=ALL,LOSS=huber --array=0-9 ...                       # Huber arm (GKX 2020; delta auto = 1.345*sigma, logged in train.log)
#   sbatch --export=ALL,LOSS=mse_csvar,CSVAR_LAMBDA=1.0 --array=0-9 ...  # dispersion-penalized MSE arm
#   sbatch --export=ALL,LOSS=mse_csvar,CSVAR_LAMBDA=0.0 --array=0-9 ...  # batch-MSE CONTROL (isolates batch-vs-stochastic pathway)
#   sbatch --export=ALL,IC_MODE=spearman --array=0-9 ...                 # soft-Spearman IC variant
#   sbatch --export=ALL,IC_VAR_LAMBDA=0.5 --array=0-9 ...                # weaker anti-collapse term
#   sbatch --export=ALL,IC_VAR_LAMBDA=0 --array=0 ...                    # pure IC (collapses; reference only)
#   sbatch --export=ALL,MAXG=2000 --array=0-9 ...                        # cheaper
#
# The IC-vs-MSE comparison (the whole point) is LOSS=ic vs LOSS=mse on identical
# data/search/config; the two arms land in separate test_output/{ic_pearson,mse}_*
# namespaces. Evaluate both with scripts/stock_run/eval_ic_run.sh.
#
# Requires the ALIGNED cohort (identical calendars so the cross-section is well
# defined); build + transfer it first:
#   python3 scripts/stock_run/align_cohort.py \
#       --in datasets/walkforward/cohort_2021 --out datasets/walkforward/cohort_2021_aligned
# Output: $OUT_ROOT/run_R/global_best_genome_*.bin  (+ .done, safe to resubmit).

#SBATCH --account=cis251123
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1
#SBATCH --time=08:00:00
#SBATCH --job-name=ic_train
#SBATCH --array=0-9
#SBATCH --output=slurm_logs/ic_%A_%a.out
#SBATCH --error=slurm_logs/ic_%A_%a.err

module --force purge
module load gcc/11.2.0 openmpi/4.1.6

cd "$SLURM_SUBMIT_DIR"

set -u
MAXG=${MAXG:-10000}
# save_genome_option: 'none' writes only the final global best (at natural termination).
# Set SAVE_GENOMES=all_best_genomes to also write every new global-best genome DURING
# the run (rnn_genome_<N>.bin) -- lets you evaluate intermediate genomes while it runs
# (recommended for the canary; a few extra small files).
SAVE_GENOMES=${SAVE_GENOMES:-none}
# LOSS selects the objective. The matched MSE baseline is THIS SAME SCRIPT with
# --export=ALL,LOSS=mse -- identical data/search/config, only the loss differs, so
# the IC-vs-MSE comparison is apples-to-apples by construction.
#   huber     : residual-clipped pointwise loss (GKX 2020); delta = 1.345*sigma of the
#               normalized training targets, auto-computed by the binary (no tuning).
#   mse_csvar : dispersion-penalized MSE, L = MSE + CSVAR_LAMBDA*mean_date Var_cs(pred).
#               CSVAR_LAMBDA=0 is the batch-MSE CONTROL arm (isolates the batch-vs-
#               stochastic optimizer pathway from the penalty effect).
LOSS=${LOSS:-ic}                     # ic (default) | mse | huber | mse_csvar
CSVAR_LAMBDA=${CSVAR_LAMBDA:-1.0}    # only used when LOSS=mse_csvar
IC_MODE=${IC_MODE:-pearson}          # pearson (default) | spearman  (ignored when LOSS=mse)
IC_VAR_LAMBDA=${IC_VAR_LAMBDA:-1.0}  # anti-collapse variance-floor weight (L = -IC + lambda*var_floor); 0 = pure IC
IC_FITNESS=${IC_FITNESS:-ic}         # selection metric: ic (mean daily IC) | icir (IC information ratio)
# TARGET selects the OUTPUT column. RET = raw next-day return (default; raw-MSE + IC arms).
# RET_CS = cross-sectional per-date z-score of RET (Qlib CSZScoreNorm) -- the z-score-MSE
# arm; requires a cohort built with scripts/stock_run/build_cs_target.py (it adds RET_CS).
# Only the target differs from raw-MSE; the 6 raw inputs/search are identical.
TARGET=${TARGET:-RET}
DATA_DIR=${DATA_DIR:-datasets/walkforward/cohort_2021_aligned}
RUN_TAG=${RUN_TAG:-}
# OUT_ROOT derives from DATA_DIR + objective + RUN_TAG so ic-pearson / ic-spearman /
# mse and any config change get separate run_R namespaces (a forgotten --export
# otherwise lands on another config's .done files and every task exits 0 via the skip).
case "$LOSS" in
    ic)        OBJ_TAG="ic_${IC_MODE}_lam${IC_VAR_LAMBDA}_${IC_FITNESS}" ;;
    mse)       OBJ_TAG="mse" ;;
    huber)     OBJ_TAG="huber" ;;                          # delta is auto/deterministic
    mse_csvar) OBJ_TAG="mse_csvar_lam${CSVAR_LAMBDA}" ;;
    *)         echo "ERROR: LOSS must be ic|mse|huber|mse_csvar, got '$LOSS'" >&2; exit 1 ;;
esac
# a non-default target (e.g. RET_CS z-score-MSE) gets its own namespace so it never
# lands on the raw-RET arm's .done files.
[ "$TARGET" != "RET" ] && OBJ_TAG="${OBJ_TAG}_${TARGET}"
OUT_ROOT=${OUT_ROOT:-test_output/${OBJ_TAG}_$(basename "$DATA_DIR")${RUN_TAG:+_$RUN_TAG}}
BIN=build/mpi/examm_mpi

IDX=${SLURM_ARRAY_TASK_ID:-0}
RUN=$(( IDX + 1 ))
OUT=$OUT_ROOT/run_$RUN

echo "### train | loss $LOSS | obj $OBJ_TAG | run $RUN | max_genomes $MAXG | ranks ${SLURM_NTASKS}"

if [ "$LOSS" = "ic" ] && [ "$IC_MODE" != "pearson" ] && [ "$IC_MODE" != "spearman" ]; then
    echo "ERROR: IC_MODE must be 'pearson' or 'spearman', got '$IC_MODE'" >&2; exit 1
fi
if [ ! -x "$BIN" ]; then echo "ERROR: $BIN not found -- build examm_mpi first" >&2; exit 1; fi
if [ ! -d "$DATA_DIR" ]; then echo "ERROR: $DATA_DIR missing -- run align_cohort.py + transfer" >&2; exit 1; fi

# ---- collect the pooled file lists (ALL stocks) ----------------------------
TRAIN_FILES=$(ls "$DATA_DIR"/*_train.csv 2>/dev/null | tr '\n' ' ')
VAL_FILES=$(ls "$DATA_DIR"/*_val.csv   2>/dev/null | tr '\n' ' ')
N_TRAIN=$(echo $TRAIN_FILES | wc -w | tr -d ' ')
N_VAL=$(echo $VAL_FILES   | wc -w | tr -d ' ')
if [ "$N_TRAIN" -lt 50 ] || [ "$N_TRAIN" -ne "$N_VAL" ]; then
    echo "ERROR: $DATA_DIR has $N_TRAIN train / $N_VAL val files (expected equal, >=50)" >&2
    exit 1
fi
# Counts matching is not enough -- a partial rsync could drop one stem from each side.
if ! diff <(ls "$DATA_DIR" | sed -n 's/_train\.csv$//p') \
          <(ls "$DATA_DIR" | sed -n 's/_val\.csv$//p') >/dev/null; then
    echo "ERROR: train/val stems differ in $DATA_DIR (counts match but sets do not)" >&2
    exit 1
fi
# Cross-sectional IC requires calendar-aligned (equal-length) train series. The C++
# also asserts this, but fail here with a clearer message than a mid-run abort.
NUNIQ=$(for f in $TRAIN_FILES; do wc -l < "$f"; done | sort -u | wc -l | tr -d ' ')
if [ "$NUNIQ" -ne 1 ]; then
    echo "ERROR: train files in $DATA_DIR are not equal-length -- not aligned." >&2
    echo "       Rebuild with scripts/stock_run/align_cohort.py" >&2
    exit 1
fi
# The output column must exist (e.g. RET_CS only exists in a build_cs_target.py cohort);
# fail here with a clear message rather than a mid-run C++ abort on a missing parameter.
FIRST_TRAIN=$(echo $TRAIN_FILES | cut -d' ' -f1)
if ! head -1 "$FIRST_TRAIN" | tr -d '\r' | tr ',' '\n' | grep -qx "$TARGET"; then
    echo "ERROR: output column '$TARGET' not in $FIRST_TRAIN header." >&2
    echo "       For TARGET=RET_CS build the cohort with scripts/stock_run/build_cs_target.py" >&2
    exit 1
fi
echo "pooled over $N_TRAIN stocks (aligned), target=$TARGET"

if [ -f "$OUT/.done" ]; then
    echo "[run $RUN] already done, skipping"; exit 0
fi

# Atomic ownership claim (see anvil_vol_cold.sb rationale).
mkdir -p "$(dirname "$OUT")"
if ! mkdir "$OUT.lock" 2>/dev/null; then
    echo "[run $RUN] another task owns $OUT, skipping"; exit 0
fi
trap 'rmdir "$OUT.lock" 2>/dev/null' EXIT

case "$OUT" in */run_[0-9]*) ;; *) echo "ERROR: refusing rm -rf '$OUT'" >&2; exit 1;; esac
rm -rf "$OUT"; mkdir -p "$OUT"
printf 'data_dir=%s\nloss=%s\nic_mode=%s\nic_var_lambda=%s\nic_fitness=%s\ncsvar_lambda=%s\ntarget=%s\nrun=%s\nrun_tag=%s\nmax_genomes=%s\nseed=%s\nstocks=%s\n' \
    "$DATA_DIR" "$LOSS" "$IC_MODE" "$IC_VAR_LAMBDA" "$IC_FITNESS" "$CSVAR_LAMBDA" "$TARGET" "$RUN" "${RUN_TAG:-none}" "$MAXG" "$RUN" "$N_TRAIN" > "$OUT/.config"

# Objective flags. Everything else is identical between all arms:
#   ic        -> --loss ic + ic knobs
#   mse       -> --loss mse                (stochastic path)
#   huber     -> --loss huber              (stochastic path; delta auto-computed+logged)
#   mse_csvar -> --loss mse_csvar + lambda (batch cross-sectional path; lam 0 = control)
case "$LOSS" in
    ic)        LOSS_ARGS="--loss ic --ic_mode $IC_MODE --ic_var_lambda $IC_VAR_LAMBDA --ic_fitness $IC_FITNESS" ;;
    huber)     LOSS_ARGS="--loss huber" ;;
    mse_csvar) LOSS_ARGS="--loss mse_csvar --csvar_lambda $CSVAR_LAMBDA" ;;
    *)         LOSS_ARGS="--loss mse" ;;
esac

# Search config matches anvil_vol_cold.sb / Evostar 2025 (repopulation every 500,
# islands 10x10, bp 10). time_offset 1 (predict next-day RET); inputs are the 6
# reversal predictors.
srun --kill-on-bad-exit -n "${SLURM_NTASKS}" "$BIN" \
    --training_filenames $TRAIN_FILES \
    --validation_filenames $VAL_FILES \
    --seed "$RUN" \
    --time_offset 1 \
    --input_parameter_names RET VOL_CHANGE BA_SPREAD ILLIQUIDITY sprtrn TURNOVER \
    --output_parameter_names $TARGET \
    $LOSS_ARGS \
    --number_islands 10 \
    --island_size 10 \
    --max_genomes "$MAXG" \
    --bp_iterations 10 \
    --num_mutations 1 \
    --normalize avg_std_dev \
    --extinction_event_generation_number 500 \
    --islands_to_exterminate 1 \
    --repopulation_method bestGenome \
    --output_directory "$OUT" \
    --save_genome_option "$SAVE_GENOMES" \
    --std_message_level INFO \
    --file_message_level NONE > "$OUT/train.log" 2>&1
RC=$?

GB=$(ls "$OUT"/global_best_genome_*.bin 2>/dev/null \
     | sed 's/.*_\([0-9]*\)\.bin/\1 &/' | sort -rn | head -1 | cut -d' ' -f2-)
LOGGED=$(wc -l < "$OUT/fitness_log.csv" 2>/dev/null || echo 0)
MIN_LOGGED=$(( MAXG * 9 / 10 ))

if [ $RC -eq 0 ] && [ -n "$GB" ] && [ -s "$GB" ] && [ "$LOGGED" -ge "$MIN_LOGGED" ]; then
    touch "$OUT/.done"
    echo "[run $RUN] FINISHED  genome=$(basename "$GB")  genomes_logged=$LOGGED"
else
    echo "[run $RUN] FAILED rc=$RC genome='${GB:-none}' logged=$LOGGED (need >=$MIN_LOGGED)" >&2
    echo "          see $OUT/train.log" >&2
    exit 1
fi
